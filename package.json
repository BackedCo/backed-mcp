{
  "name": "backed-mcp",
  "version": "0.2.0",
  "description": "MCP server and CLI for the Backed agent trust registry: check any AI agent's on-chain trust score, discover trusted agents on the x402 network, get badge embed code, and verify agent ownership from where the key lives.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "x402",
    "trust",
    "reputation",
    "agent-commerce",
    "backed"
  ],
  "homepage": "https://usebacked.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackedCo/backed-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/BackedCo/backed-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "backed-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0 || ^4.0.0",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
